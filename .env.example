# Copier ce fichier en .env (ignoré par git) puis adapter les valeurs. Aucune valeur réelle ne doit être versionnée.

# Mot de passe de l'administrateur SQL Server du conteneur local (règles de complexité SQL Server : 8 caractères min.,
# majuscules, minuscules, chiffres et symboles). Éviter « ; » (séparateur de chaîne de connexion).
MSSQL_SA_PASSWORD=Exemple-Local-123!

# Clé d'administration attendue dans l'en-tête X-Admin-Key (endpoints /api/admin/catalog/*).
ADMIN_API_KEY=exemple-cle-admin-locale
